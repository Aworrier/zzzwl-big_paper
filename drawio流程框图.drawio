          <mxGeometry height="46.65551839464883" width="247.01397712833545" x="282.007623888183" as="geometry" />
        </mxCell>
        <mxCell id="xSTXUiW5_OFfeEnlzu4C-3" parent="_4euc7m_Xn5v7e6feGTS-1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;container=0;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;路径一：经典建模分析[56-58]&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;text-align: justify; border-color: rgb(130, 179, 102); margin: 4px 0px;&quot;&gt;&lt;div style=&quot;text-align: justify; line-height: 1.3;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;机制&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;：Bianchi 马尔可夫链分析&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify; line-height: 1.3;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;特点&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;：揭示侦听/退避与稳态的内在关联&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="114.04682274247492" width="257.3062261753494" y="82.94314381270902" as="geometry" />
        </mxCell>
