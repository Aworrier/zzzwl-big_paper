  <diagram id="dyB4RfJLWr-YGgg5tAJ8" name="AI驱动接入控制决策研究技术脉络">
    <mxGraphModel dx="1554" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sgzTx9yTV7A4TZJnq47W-2" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="329.99999999999994" width="1060" x="55" y="30" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-14" parent="sgzTx9yTV7A4TZJnq47W-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003D7A;strokeColor=#00264D;fontColor=#ffffff;fontStyle=1;fontFamily=Times New Roman;spacing=5;autosizeText=1;fontSize=18;container=0;convertToSvg=0;" value="引入数据驱动学习 (Machine Learning / Reinforcement Learning)&lt;br&gt;&lt;font style=&#39;font-size: 12px; font-weight: normal;&#39;&gt;解决固定规则难以适应动态业务特征的问题&lt;/font&gt;" vertex="1">
          <mxGeometry height="71.74" width="518.5" x="250" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-15" parent="sgzTx9yTV7A4TZJnq47W-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=1;fontSize=13;container=0;convertToSvg=0;" value="路径一：接入架构完全重构&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：多智能体端到端学习底层信令与规则&lt;br&gt;特点：颠覆传统协议，但缺乏解释性且训练极度困难&lt;/font&gt;" vertex="1">
          <mxGeometry height="93.26086956521739" width="331.25" y="129.1304347826087" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-16" parent="sgzTx9yTV7A4TZJnq47W-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=1;fontSize=13;container=0;convertToSvg=0;" value="路径二：单协议参数动态优化&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：DQN学习发送概率、竞争窗口等标量&lt;br&gt;特点：保留成熟框架，但性能上限受既有协议结构制约&lt;/font&gt;" vertex="1">
          <mxGeometry height="93.26086956521739" width="331.25" x="357.75" y="129.1304347826087" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-17" parent="sgzTx9yTV7A4TZJnq47W-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=1;fontSize=13;container=0;convertToSvg=0;" value="路径三：协议选择与模块化组合&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：基于场景特征利用代理模型切换协议实例&lt;br&gt;特点：兼顾传统稳定与AI灵活，但面临跨场景泛化难题&lt;/font&gt;" vertex="1">
          <mxGeometry height="93.26086956521739" width="344.5" x="715.5" y="129.1304347826087" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-18" parent="sgzTx9yTV7A4TZJnq47W-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7F5;strokeColor=#D6A39E;fontColor=#8A3129;fontStyle=1;fontFamily=Times New Roman;dashed=1;spacingLeft=10;autosizeText=1;fontSize=15;container=0;convertToSvg=0;" value="现有局限性：普遍存在训练成本高、在线响应速度有限、工程可部署性不足的问题。缺乏在统一框架下实现低开销、秒级响应的系统级自适应决策方案。" vertex="1">
          <mxGeometry height="57.391304347826086" width="1060" y="272.6086956521739" as="geometry" />
        </mxCell>
        <mxCell id="CK86J5eqz18-W5eqHXiG-19" edge="1" parent="sgzTx9yTV7A4TZJnq47W-2" source="CK86J5eqz18-W5eqHXiG-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1.5;strokeColor=#73889E;autosizeText=1;convertToSvg=0;" target="CK86J5eqz18-W5eqHXiG-15">
