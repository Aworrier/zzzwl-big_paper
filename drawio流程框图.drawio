  <diagram id="nZdb8a9xb91aLgbOfDh3" name="CSMA/LBT类随机接入协议研究技术脉络">
    <mxGraphModel dx="1554" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-37" connectable="0" parent="1" style="group;fontSize=13;autosizeText=0;" value="CSMA" vertex="1">
          <mxGeometry height="380" width="1110" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-14" parent="uEB2bZCqmNAqUQUNVUVe-37" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003D7A;strokeColor=#00264D;fontColor=#ffffff;fontStyle=1;fontFamily=Times New Roman;spacing=5;autosizeText=0;fontSize=28;" value="传统 CSMA / LBT 基础机制&lt;br&gt;&lt;font style=&#39;font-size: 12px; font-weight: normal;&#39;&gt;载波侦听 (先听后发) / 随机退避与竞争窗口扩展&lt;/font&gt;" vertex="1">
          <mxGeometry height="82.6086956521739" width="388.49999999999994" x="346.87499999999994" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-15" parent="uEB2bZCqmNAqUQUNVUVe-37" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=0;fontSize=15;" value="路线一：经典性能建模与理论分析&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：Bianchi二维马尔可夫链、饱和/非饱和分析&lt;br&gt;特点：揭示侦听/碰撞时长与系统稳态的内在关系&lt;/font&gt;" vertex="1">
          <mxGeometry height="107.3913043478261" width="346.87499999999994" y="148.69565217391303" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-16" parent="uEB2bZCqmNAqUQUNVUVe-37" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=0;fontSize=14;" value="路线二：退避与竞争窗口优化&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：自适应BEB、优先级退避 (EDCA)、碰撞优先&lt;br&gt;特点：改善公平性与时延，但高度依赖网络状态感知&lt;/font&gt;" vertex="1">
          <mxGeometry height="107.3913043478261" width="346.87499999999994" x="374.62499999999994" y="148.69565217391303" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-17" parent="uEB2bZCqmNAqUQUNVUVe-37" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;autosizeText=0;fontSize=13;" value="路线三：冲突避免与场景适配&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：RTS/CTS、CR-LBT、异构共存与能效优化&lt;br&gt;特点：拓展了协议适用范围，但增加了信令交互与复杂度&lt;/font&gt;" vertex="1">
          <mxGeometry height="107.3913043478261" width="360.74999999999994" x="749.2499999999999" y="148.69565217391303" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-18" parent="uEB2bZCqmNAqUQUNVUVe-37" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7F5;strokeColor=#D6A39E;fontColor=#8A3129;fontStyle=1;fontFamily=Times New Roman;dashed=1;spacingLeft=10;autosizeText=0;fontSize=16;" value="现有局限性：多数研究仍围绕“侦听前后”展开，单纯依靠退避优化无法消除成功接入后的资源释放重竞开销。在高动态下难以兼顾高吞吐与实现复杂度。" vertex="1">
          <mxGeometry height="66.08695652173913" width="1110" y="313.9130434782609" as="geometry" />
        </mxCell>
        <mxCell id="uEB2bZCqmNAqUQUNVUVe-19" edge="1" parent="uEB2bZCqmNAqUQUNVUVe-37" source="uEB2bZCqmNAqUQUNVUVe-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1.5;strokeColor=#73889E;autosizeText=0;" target="uEB2bZCqmNAqUQUNVUVe-15">
