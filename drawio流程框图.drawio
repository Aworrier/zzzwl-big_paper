        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 14px; color:#333;&quot;&gt;一、传统 Aloha 机制演进：按包竞争导致的碰撞难以控制&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="400" x="33" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;传统 Aloha 基础机制&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;时隙离散并发 · 碰撞即退避重传&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="240" x="270" y="44" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;流量调度与接入控制&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• 自适应发送概率与差异化退避&lt;br&gt;• 缓解轻中载拥塞，无物理层改动&lt;/div&gt;" vertex="1">
          <mxGeometry height="66" width="220" x="20" y="94" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;多维资源扩展&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• 多信道 OFDMA 与预约接入映射&lt;br&gt;• 降低单点竞争，但增加同步开销&lt;/div&gt;" vertex="1">
          <mxGeometry height="66" width="220" x="280" y="94" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;接收增强与多包接收&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• SIC 干扰消除 (CRDSA) 与 NOMA&lt;br&gt;• 提升吞吐量，但设备硬件功耗较高&lt;/div&gt;" vertex="1">
          <mxGeometry height="66" width="220" x="540" y="94" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-8" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 14px; color:#333;&quot;&gt;二、&lt;/b&gt;&lt;span style=&quot;font-size: 14px; color:#333;&quot;&gt;&lt;b&gt;CSMA/LBT 机制演进：高动态场景下载波侦听开销过大&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="450" x="33" y="165" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;传统 CSMA/LBT 基础机制&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;信道载波侦听 (LBT) · 竞争窗口退避扩展&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="240" x="270" y="187" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;经典建模与理论分析&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• 二维马尔可夫链稳态模型&lt;br&gt;• 说明了侦听/退避与性能的关联&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="220" x="20" y="237" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;退避与竞争窗口优化&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• 自适应 BEB 与 EDCA 优先级退避&lt;br&gt;• 改善公平性，但依赖于准确的状态感知&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="220" x="280" y="237" as="geometry" />
        </mxCell>
        <mxCell id="ZS_VE-CUzkJx8Q_fFa2P-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=4;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;冲突避免与场景适配&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• RTS/CTS 与 异构共存规避机制&lt;br&gt;• 拓宽适用范围，但导致信令变复杂&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="220" x="540" y="237" as="geometry" />
