        <mxCell id="1LWQUsClrXU8AzRMe0_A-38" parent="8TBLl8yjGGrPTM66MPcr-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003D7A;strokeColor=#00264D;fontColor=#ffffff;fontStyle=1;fontFamily=Times New Roman;spacing=5;container=0;autosizeText=1;fontSize=20;" value="传统 Aloha 基础机制&lt;br&gt;&lt;font style=&#39;font-size: 12px; font-weight: normal;&#39;&gt;时隙离散并发 / 碰撞即退避重传&lt;/font&gt;" vertex="1">
          <mxGeometry height="62.96296296296296" width="314.6835443037975" x="400.50632911392404" as="geometry" />
        </mxCell>
        <mxCell id="1LWQUsClrXU8AzRMe0_A-39" parent="8TBLl8yjGGrPTM66MPcr-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;container=0;autosizeText=1;fontSize=18;" value="路径一：流量调度与接入控制&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：自适应发送概率、差异化退避&lt;br&gt;特点：无需改动物理层，缓解轻中载拥塞&lt;/font&gt;" vertex="1">
          <mxGeometry height="81.85185185185185" width="343.2911392405063" y="113.33333333333331" as="geometry" />
        </mxCell>
        <mxCell id="1LWQUsClrXU8AzRMe0_A-40" parent="8TBLl8yjGGrPTM66MPcr-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;container=0;autosizeText=1;fontSize=16;" value="路径二：多维度资源扩展&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：多信道OFDMA、预约接入预映射&lt;br&gt;特点：并行降低单源竞争，但增大了同步开销&lt;/font&gt;" vertex="1">
          <mxGeometry height="81.85185185185185" width="343.2911392405063" x="386.2025316455696" y="113.33333333333331" as="geometry" />
        </mxCell>
        <mxCell id="1LWQUsClrXU8AzRMe0_A-41" parent="8TBLl8yjGGrPTM66MPcr-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#628CB6;fontColor=#003D7A;fontStyle=1;spacing=5;container=0;autosizeText=1;fontSize=16;" value="路径三：接收端增强与多包接收&lt;br&gt;&lt;font style=&#39;font-size: 11px; font-weight: normal; color: #555;&#39;&gt;机制：SIC消除 (CRDSA)、非正交多址 (NOMA)&lt;br&gt;特点：突破吞吐量上限，但硬件复杂度/功耗极高&lt;/font&gt;" vertex="1">
          <mxGeometry height="81.85185185185185" width="357.59493670886076" x="772.4050632911392" y="113.33333333333331" as="geometry" />
        </mxCell>
        <mxCell id="1LWQUsClrXU8AzRMe0_A-42" parent="8TBLl8yjGGrPTM66MPcr-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7F5;strokeColor=#D6A39E;fontColor=#8A3129;fontStyle=1;fontFamily=Times New Roman;dashed=1;spacingLeft=10;container=0;autosizeText=1;fontSize=18;" value="现有局限性：强动态、大规模场景下，难以在【低复杂度】与【高吞吐/低时延】之间取得均衡，未从根本解决“按包重复竞争”的开销问题。" vertex="1">
          <mxGeometry height="50.370370370370374" width="1130" y="239.25925925925924" as="geometry" />
        </mxCell>
        <mxCell id="1LWQUsClrXU8AzRMe0_A-43" edge="1" parent="8TBLl8yjGGrPTM66MPcr-2" source="1LWQUsClrXU8AzRMe0_A-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=1.5;strokeColor=#73889E;autosizeText=1;" target="1LWQUsClrXU8AzRMe0_A-39">
