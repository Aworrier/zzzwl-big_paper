          <mxGeometry height="110" width="260" x="270" y="80" as="geometry" />
        </mxCell>
        <mxCell id="wq85I_4TxUJcO7-9Xvpv-6" parent="eM-WXDGffyEjJRHUD-C4-1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;container=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;路径三：协议选择与组合&lt;/b&gt;[76-78]&lt;hr style=&quot;border-color: rgb(130, 179, 102); margin: 4px 0px;&quot;&gt;&lt;div style=&quot;text-align: left; line-height: 1.3;&quot;&gt;&lt;b&gt;机制&lt;/b&gt;：模型驱动的协议实例切换&lt;br&gt;&lt;b&gt;特点&lt;/b&gt;：兼顾稳定与智能，跨场景泛化难&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="540" y="80" as="geometry" />
        </mxCell>
        <mxCell id="wq85I_4TxUJcO7-9Xvpv-7" parent="eM-WXDGffyEjJRHUD-C4-1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;&lt;font&gt;固有局限：工程可部署性与实时动态响应能力的不足&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;border-color: rgb(184, 84, 80); margin: 4px 0px;&quot;&gt;&lt;div style=&quot;color: rgb(51, 51, 51);&quot;&gt;&lt;font&gt;高昂训练成本下难以兼顾&lt;b&gt;实时响应&lt;/b&gt;与&lt;b&gt;设备低算力约束，&lt;/b&gt;缺乏&lt;b&gt;低开销&lt;/b&gt;、&lt;b&gt;可部署&lt;/b&gt;的自适应联合决策机制。&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="800" y="230" as="geometry" />
        </mxCell>
