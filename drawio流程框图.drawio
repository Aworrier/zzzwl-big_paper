          <mxGeometry height="45" width="240" x="250" y="40" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-20" parent="pdHkS-zhkIUNmH-kL5Bg-16" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径一：经典建模与理论分析&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：Bianchi 二维马尔可夫链分析&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：揭示侦听/退避与稳态的内在关联&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="225" x="15" y="115" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-21" parent="pdHkS-zhkIUNmH-kL5Bg-16" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径二：退避与竞争窗口优化&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：自适应 BEB、优先级退避 (EDCA)&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：改善公平性，但高度依赖状态感知&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="225" x="257.5" y="115" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-22" parent="pdHkS-zhkIUNmH-kL5Bg-16" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径三：冲突避免与场景适配&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：RTS/CTS、CR-LBT、异构共存&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：拓宽适用范围，但激增信令复杂度&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="225" x="500" y="115" as="geometry" />
