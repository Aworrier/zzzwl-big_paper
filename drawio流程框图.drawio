          <mxGeometry height="114.04682274247492" width="257.3062261753494" x="276.8907242693774" y="82.94314381270902" as="geometry" />
        </mxCell>
        <mxCell id="xSTXUiW5_OFfeEnlzu4C-5" parent="_4euc7m_Xn5v7e6feGTS-1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;container=0;" value="&lt;b&gt;路径三：&lt;/b&gt;&lt;b&gt;冲突与场景适配[63-66]&lt;/b&gt;&lt;hr style=&quot;border-color: rgb(130, 179, 102); margin: 4px 0px;&quot;&gt;&lt;div style=&quot;text-align: justify; line-height: 1.3;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;机制&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;：RTS/CTS、异构共存&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify; line-height: 1.3;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;特点&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;：拓宽适用范围，信令复杂度激增&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="114.04682274247492" width="257.3062261753494" x="545.4891994917407" y="82.94314381270902" as="geometry" />
        </mxCell>
        <mxCell id="xSTXUiW5_OFfeEnlzu4C-6" parent="_4euc7m_Xn5v7e6feGTS-1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;fillColor=#e1d5e7;strokeColor=#9673a6;container=0;" value="&lt;b&gt;&lt;font&gt;固有局限：高并发与高负载下系统性能难以权衡的原生瓶颈&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;border-color: rgb(184, 84, 80); margin: 4px 0px;&quot;&gt;&lt;div style=&quot;color: rgb(51, 51, 51);&quot;&gt;难以兼顾&lt;b&gt;高吞吐量&lt;/b&gt;、&lt;b&gt;低复杂度&lt;/b&gt;以及&lt;b&gt;公平性&lt;/b&gt;；&lt;/div&gt;&lt;div style=&quot;color: rgb(51, 51, 51);&quot;&gt;单纯优化未突破由&lt;b&gt;侦听失败&lt;/b&gt;与&lt;b&gt;反复竞争&lt;/b&gt;引发的内在信令开销桎梏。&lt;/div&gt;" vertex="1">
