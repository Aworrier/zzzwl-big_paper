        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-34" parent="pdHkS-zhkIUNmH-kL5Bg-30" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径一：接入架构完全重构&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：多智能体端到端重构底层信令&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：颠覆标准，零解释性且极难收敛&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="231.08108108108107" x="15.405405405405405" y="138" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-35" parent="pdHkS-zhkIUNmH-kL5Bg-30" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径二：单协议参数动态优化&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：DRL 调优竞争窗口 / 发送概率&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：兼容性好，但受限协议原生瓶颈&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="231.08108108108107" x="264.4594594594594" y="138" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-36" parent="pdHkS-zhkIUNmH-kL5Bg-30" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;路径三：协议选择与模块组合&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：代理模型驱动的协议实例切换&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：兼顾稳定与智能，跨场景泛化难&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="231.08108108108107" x="513.5135135135134" y="138" as="geometry" />
        </mxCell>
        <mxCell id="pdHkS-zhkIUNmH-kL5Bg-37" parent="pdHkS-zhkIUNmH-kL5Bg-30" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 13px; color:#8a3129;&quot;&gt;固有局限：工程可部署性与实时动态响应能力的严重不足&lt;/b&gt;&lt;hr style=&quot;border-color:#b85450;margin:4px 0;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: center; color:#333;&quot;&gt;高昂训练成本下难以兼顾&lt;b&gt;亚毫秒级实时响应&lt;/b&gt;与&lt;b&gt;设备低算力约束&lt;/b&gt;；目前缺乏在统一框架下实现&lt;br&gt;低开销、可部署的系统级自适应联合决策机制。&lt;/div&gt;" vertex="1">
