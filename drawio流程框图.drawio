        <mxCell id="mJGa0G7FCUklgAyDEIZf-42" parent="XtwIHFxFDdTfzPE0MvqO-3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;现有 MAC 层多址接入机制面临的核心瓶颈&lt;/b&gt;" vertex="1">
