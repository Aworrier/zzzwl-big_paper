        <mxCell id="uJrgfHhqWvyiDE646FPy-35" parent="VoWZe14lkBIu6OuGeRi_-4" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;路径三：接收机增强[45-54]&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; line-height: 1.3;&quot;&gt;&lt;b&gt;机制&lt;/b&gt;：SIC 消除、NOMA&lt;br&gt;&lt;b&gt;特点&lt;/b&gt;：突破吞吐上限，硬件功耗极高&lt;/div&gt;" vertex="1">
          <mxGeometry height="104.4" width="226" x="550" y="85.6" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-36" parent="VoWZe14lkBIu6OuGeRi_-4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=17;fillColor=#e1d5e7;strokeColor=#9673a6;flipH=1;legacyAnchorPoints=0;" value="&lt;b&gt;&lt;font&gt;固有局限：强动态与大规模场景下的本质性能瓶颈&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;border-color:#b85450;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: center; color: rgb(51, 51, 51);&quot;&gt;难以在&lt;b&gt;低设备复杂度&lt;/b&gt;与&lt;b&gt;高吞吐/低时延&lt;/b&gt;之间取得有效均衡；未从根本上解决由&lt;b&gt;按包重复竞争&lt;/b&gt;引发的核心信令与时间开销问题。&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="777" x="1" y="230" as="geometry" />
