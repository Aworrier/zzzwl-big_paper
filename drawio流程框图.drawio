        <mxCell id="ZZKEnqDLTH4ME7bM_Tr5-1" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="250" width="800" x="14" y="90" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-32" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=14;" value="&lt;b&gt;传统 Aloha 基础机制&lt;/b&gt;&lt;br&gt;&lt;span&gt;时隙离散并发 · 碰撞即退避重传&lt;/span&gt;" vertex="1">
          <mxGeometry height="45" width="240" x="280" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-33" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=14;" value="&lt;b&gt;路径一：流量调度与接入控制&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：自适应发送概率、差异化退避&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：无物理层改动，缓解轻中载拥塞&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="260" y="80" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-34" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=14;" value="&lt;b&gt;路径二：多维资源扩展&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：多信道 OFDMA、预约接入映射&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：降低单点竞争，但同步开销增大&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="260" x="270" y="80" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-35" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=14;" value="&lt;b&gt;路径三：接收增强与多包接收&lt;/b&gt;&lt;hr style=&quot;border-color:#82b366;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: left; line-height: 1.3;&quot;&gt;• &lt;b&gt;机制&lt;/b&gt;：SIC 消除 (CRDSA)、NOMA&lt;br&gt;• &lt;b&gt;特点&lt;/b&gt;：突破吞吐上限，硬件功耗极高&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="260" x="540" y="80" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-36" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=6;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;fontSize=14;" value="&lt;b style=&quot;color: rgb(138, 49, 41);&quot;&gt;固有局限：强动态与大规模场景下的本质性能瓶颈&lt;/b&gt;&lt;hr style=&quot;border-color:#b85450;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align: center; color: rgb(51, 51, 51);&quot;&gt;难以在&lt;b&gt;低设备复杂度&lt;/b&gt;与&lt;b&gt;高吞吐/低时延&lt;/b&gt;之间取得有效均衡；未从根本上解决由&lt;b&gt;按包重复竞争&lt;/b&gt;引发的核心信令与时间开销问题。&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="800" y="200" as="geometry" />
        </mxCell>
        <mxCell id="uJrgfHhqWvyiDE646FPy-37" edge="1" parent="ZZKEnqDLTH4ME7bM_Tr5-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;strokeWidth=1.5;labelBackgroundColor=none;fontColor=default;fontSize=14;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="uJrgfHhqWvyiDE646FPy-33">
