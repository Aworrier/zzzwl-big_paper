        <mxCell id="mJGa0G7FCUklgAyDEIZf-43" parent="XtwIHFxFDdTfzPE0MvqO-3" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;paddingTop=5;paddingLeft=8;paddingRight=8;fontFamily=Times New Roman, SimSun;labelBackgroundColor=none;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;瓶颈一：底层性能边界&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;(授权频段 Aloha/SDT 类)&lt;/span&gt;&lt;hr style=&quot;border-color:#d79b00;margin-top:4px;margin-bottom:4px;&quot;&gt;&lt;div style=&quot;font-size: 12px; text-align: left;&quot;&gt;• 基于按包独立竞争框架&lt;br&gt;• 碰撞累积且接入传输激增&lt;br&gt;• 局部修补未突破吞吐上限&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="225" x="11.5" y="185" as="geometry" />
